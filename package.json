{
  "name": "linecheck",
  "version": "0.1.0",
  "private": true,
  "description": "An AI inspector aircraft technicians call on FaceTime: sees the part, finds the procedure, checks ADs and known failures, drafts the work order.",
  "type": "module",
  "engines": {
    "node": "^22.23.2 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "agent": "node --env-file-if-exists=.env.local agent/agent.mjs start",
    "agent:dev": "node --env-file-if-exists=.env.local agent/agent.mjs dev",
    "board": "node --env-file-if-exists=.env.local board/server.mjs",
    "ingest": "node --env-file-if-exists=.env.local scripts/ingest.mjs",
    "ask": "node --env-file-if-exists=.env.local scripts/ask.mjs",
    "check": "node --check agent/agent.mjs && node --check board/server.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@livekit/agents": "1.8.0",
    "@livekit/agents-plugin-openai": "1.8.0",
    "@livekit/rtc-node": "0.13.35",
    "pdfjs-dist": "4.10.38",
    "zod": "3.25.76"
  }
}
