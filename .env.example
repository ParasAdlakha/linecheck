# Copy to .env.local and fill in. Never commit .env.local.

# LiveKit Cloud project (Settings > API keys). All three from the same project.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# OpenAI key with Realtime access and credits. Used for the voice and for image inspection.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Optional overrides
# REALTIME_MODEL=gpt-realtime
# REALTIME_VOICE=marin
# VISION_MODEL=gpt-5-mini

# Keenable key from keenable.ai/console (hackathon code BETA200). Without it, the keyless public endpoint is used.
KEENABLE_API_KEY=

# A name no other team uses. chert dev reads it from this file.
AGENT_NAME=linecheck-adlakha

# Where the agent posts work-order updates. Use your laptop's LAN IP so the phone /snap page works too.
BOARD_URL=http://localhost:8787
BOARD_PORT=8787
# Optional shared secret between agent and board
BOARD_TOKEN=
